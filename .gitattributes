# Keep LF in the repository and in working trees on every OS.
# This prevents CRLF shebangs from breaking scripts inside Linux containers.
* text=auto eol=lf

*.sh   text eol=lf
*.py   text eol=lf
*.js   text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf
